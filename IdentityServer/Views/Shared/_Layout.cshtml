<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IdentityServer</title>
    <style>
        body { font-family: Segoe UI, sans-serif; margin: 2rem; }
        .panel { max-width: 28rem; }
        label { display: block; margin-top: 0.75rem; }
        input[type=text], input[type=password] { width: 100%; padding: 0.4rem; }
        button { margin-top: 1rem; padding: 0.5rem 1rem; }
        .validation { color: #b00020; }
        .muted { color: #555; }
    </style>
</head>
<body>
    <main>
        @RenderBody()
    </main>
</body>
</html>
